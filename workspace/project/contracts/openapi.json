{
  "openapi": "3.1.0",
  "info": {
    "title": "AI-DLC Monitor API",
    "description": "로컬 전용(127.0.0.1) AI-DLC 대시보드 API. 조회 응답은 `{data, meta}` 봉투, 요청 오류는 `{\"error\":{code,message}}` (닫힌 코드 9개). 소스 문제는 HTTP 200 + `meta.status`.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/pipeline": {
      "get": {
        "tags": [
          "pipeline"
        ],
        "summary": "AI-DLC 단계 0~6 상태와 Gate 3종",
        "description": "단계 판정은 FR-001 §2(D-21). Gate 는 `aidlc.py check` 서브프로세스(TTL 5 s).",
        "operationId": "get_pipeline",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_PipelineData_"
                }
              }
            }
          },
          "400": {
            "description": "BAD_HOST — Host 가드",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "405": {
            "description": "METHOD_NOT_ALLOWED — `Allow` 헤더 포함 (OPTIONS·HEAD 포함)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/plan": {
      "get": {
        "tags": [
          "plan"
        ],
        "summary": "Phase 별 진행률과 현재·완료 Phase",
        "operationId": "get_plan",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_PlanData_"
                }
              }
            }
          },
          "400": {
            "description": "BAD_HOST — Host 가드",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "405": {
            "description": "METHOD_NOT_ALLOWED — `Allow` 헤더 포함 (OPTIONS·HEAD 포함)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tasks": {
      "get": {
        "tags": [
          "plan"
        ],
        "summary": "Task 목록 (팀·상태·Phase 필터, AND)",
        "operationId": "get_tasks",
        "parameters": [
          {
            "name": "team",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{1,30}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "팀 id",
              "title": "Team"
            },
            "description": "팀 id"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/TaskStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "open | done | blocked | active",
              "title": "Status"
            },
            "description": "open | done | blocked | active"
          },
          {
            "name": "phase",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^P\\d{1,4}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Phase (예: P1)",
              "title": "Phase"
            },
            "description": "Phase (예: P1)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_TasksData_"
                }
              }
            }
          },
          "400": {
            "description": "BAD_HOST — Host 가드",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "405": {
            "description": "METHOD_NOT_ALLOWED — `Allow` 헤더 포함 (OPTIONS·HEAD 포함)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR — 쿼리 검증",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/memory": {
      "get": {
        "tags": [
          "memory"
        ],
        "summary": "STM·LTM·Task 동기 값과 미처리 cascade",
        "description": "cascade 판정은 Hook `Memory.pending().level` (ADR-009). `aidlc.py status` 는 실행하지 않는다.",
        "operationId": "get_memory",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_MemoryData_"
                }
              }
            }
          },
          "400": {
            "description": "BAD_HOST — Host 가드",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "405": {
            "description": "METHOD_NOT_ALLOWED — `Allow` 헤더 포함 (OPTIONS·HEAD 포함)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "생존·소스 접근 가능 여부·데우기 진행률·앱 식별자",
        "description": "소스 문제는 HTTP 200 + `meta.status=partial`. 런처는 `data.app == \"aidlc-monitor\"` 로 판정한다.",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_HealthData_"
                }
              }
            }
          },
          "400": {
            "description": "BAD_HOST — Host 가드",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "405": {
            "description": "METHOD_NOT_ALLOWED — `Allow` 헤더 포함 (OPTIONS·HEAD 포함)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Envelope_HealthData_": {
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HealthData"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "title": "Envelope[HealthData]"
      },
      "Envelope_MemoryData_": {
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MemoryData"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "title": "Envelope[MemoryData]"
      },
      "Envelope_PipelineData_": {
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PipelineData"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "title": "Envelope[PipelineData]"
      },
      "Envelope_PlanData_": {
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanData"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "title": "Envelope[PlanData]"
      },
      "Envelope_TasksData_": {
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TasksData"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "title": "Envelope[TasksData]"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "BAD_HOST",
          "FORBIDDEN_ORIGIN",
          "NO_ACTIVE_LOOP",
          "TOO_MANY_STREAMS",
          "CONTROL_WRITE_FAILED",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "description": "요청 오류 본문 `{\"error\": {\"code\", \"message\"}}` (02 §6). 코드는 닫힌 집합 9개."
      },
      "Gate": {
        "properties": {
          "layer": {
            "type": "string",
            "enum": [
              "user",
              "project",
              "docs"
            ],
            "title": "Layer"
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ],
            "title": "Result"
          },
          "unwritten": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unwritten",
            "description": "미작성 플레이스홀더 수 (대상 없음·확인 불가면 null)"
          },
          "missing": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Missing",
            "description": "누락 문서 수 (대상 없음·확인 불가면 null)"
          },
          "target_missing": {
            "type": "boolean",
            "title": "Target Missing",
            "description": "대상 디렉터리 없음 (FAIL + '대상 없음')"
          },
          "no_documents": {
            "type": "boolean",
            "title": "No Documents",
            "description": "검사 대상 문서 0개로 PASS (R5)"
          },
          "error_code": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceErrorCode"
              },
              {
                "type": "null"
              }
            ]
          },
          "checked_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checked At"
          }
        },
        "type": "object",
        "required": [
          "layer",
          "result",
          "unwritten",
          "missing",
          "target_missing",
          "no_documents",
          "checked_at"
        ],
        "title": "Gate"
      },
      "HealthData": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "description": "프로세스 생존. 응답이 오면 항상 ok"
          },
          "app": {
            "type": "string",
            "const": "aidlc-monitor",
            "title": "App",
            "description": "앱 식별자. 런처의 중복 실행 판정용 — 값 고정"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "sources": {
            "$ref": "#/components/schemas/HealthSources"
          },
          "dist": {
            "type": "string",
            "enum": [
              "ok",
              "missing"
            ],
            "title": "Dist",
            "description": "프론트 dist(index.html) 유무 (ADR-005 §3)"
          },
          "usage_warming": {
            "$ref": "#/components/schemas/UsageWarming"
          }
        },
        "type": "object",
        "required": [
          "status",
          "app",
          "version",
          "sources",
          "dist",
          "usage_warming"
        ],
        "title": "HealthData"
      },
      "HealthSources": {
        "properties": {
          "workspace": {
            "type": "string",
            "enum": [
              "ok",
              "missing",
              "stale",
              "unreadable"
            ],
            "title": "Workspace",
            "description": "`<AIDLC_ROOT>/workspace/memory` 디렉터리"
          },
          "claude_projects": {
            "type": "string",
            "enum": [
              "ok",
              "missing",
              "stale",
              "unreadable"
            ],
            "title": "Claude Projects",
            "description": "`<CLAUDE_HOME>/projects` 디렉터리 (사용량 기록 위치)"
          },
          "statusline": {
            "type": "string",
            "enum": [
              "ok",
              "missing",
              "stale",
              "unreadable"
            ],
            "title": "Statusline",
            "description": "status line 스냅샷 파일. 없음 = statusLine 미실행 또는 첫 응답 전"
          },
          "control": {
            "type": "string",
            "enum": [
              "ok",
              "missing",
              "stale",
              "unreadable"
            ],
            "title": "Control",
            "description": "`.control.json`. 없음은 정상(첫 일시정지 전)이라 경고를 만들지 않는다"
          }
        },
        "type": "object",
        "required": [
          "workspace",
          "claude_projects",
          "statusline",
          "control"
        ],
        "title": "HealthSources",
        "description": "데이터 소스별 접근 가능 여부. 파일 내용은 읽지 않고 메타데이터(stat)만 본다."
      },
      "MemoryData": {
        "properties": {
          "stm": {
            "$ref": "#/components/schemas/StmView"
          },
          "ltm_rev": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ltm Rev"
          },
          "last_merged_stm": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Merged Stm"
          },
          "tasks_rev": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tasks Rev"
          },
          "synced_ltm_rev": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Synced Ltm Rev"
          },
          "current_phase": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Phase"
          },
          "completed_phases": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed Phases"
          },
          "archive_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archive Count"
          },
          "latest_archive_seq": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Archive Seq"
          },
          "pending_cascade": {
            "type": "string",
            "enum": [
              "none",
              "ltm",
              "tasks",
              "plan",
              "unknown"
            ],
            "title": "Pending Cascade",
            "description": "Hook Memory.pending().level (없음 = none, 판정 불가 = unknown)"
          },
          "stop_blocks": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stop Blocks",
            "description": "Stop Hook 연속 차단 횟수 (.cascade-state.json)"
          }
        },
        "type": "object",
        "required": [
          "stm",
          "ltm_rev",
          "last_merged_stm",
          "tasks_rev",
          "synced_ltm_rev",
          "current_phase",
          "completed_phases",
          "archive_count",
          "latest_archive_seq",
          "pending_cascade",
          "stop_blocks"
        ],
        "title": "MemoryData"
      },
      "Meta": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "partial",
              "empty",
              "error",
              "warming"
            ],
            "title": "Status"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceError"
              },
              {
                "type": "null"
              }
            ]
          },
          "generated_at": {
            "type": "string",
            "title": "Generated At",
            "description": "응답 생성 시각 (RFC 3339, UTC)"
          },
          "source_mtime": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Mtime",
            "description": "읽은 소스 파일 중 가장 최근 수정 시각 (RFC 3339, UTC)"
          }
        },
        "type": "object",
        "required": [
          "status",
          "generated_at"
        ],
        "title": "Meta"
      },
      "PhaseProgress": {
        "properties": {
          "phase": {
            "type": "string",
            "title": "Phase"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "checked": {
            "type": "integer",
            "title": "Checked"
          },
          "percent": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Percent",
            "description": "floor(checked / total × 100), total 0 이면 0"
          },
          "completed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed",
            "description": "plan completed_phases 에 있음 (plan 을 못 읽으면 null)"
          },
          "current": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current",
            "description": "plan current_phase 와 같음 (plan 을 못 읽으면 null)"
          }
        },
        "type": "object",
        "required": [
          "phase",
          "title",
          "total",
          "checked",
          "percent",
          "completed",
          "current"
        ],
        "title": "PhaseProgress"
      },
      "PipelineData": {
        "properties": {
          "current_stage": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 0.0,
            "title": "Current Stage"
          },
          "current_stage_name": {
            "type": "string",
            "title": "Current Stage Name"
          },
          "next_command": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
